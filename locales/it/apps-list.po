#: graphest:1
msgid " A faithful graphing calculator."
msgstr " A faithful graphing calculator."

#: rclone:1
msgid ""
"\"rsync for cloud storage\", CLI that supports Google Drive, S3, Dropbox, "
"Backblaze B2, One Drive, Swift, Hubic, Wasabi, Google Cloud Storage, Azure "
"Blob, Azure Files, Yandex Files."
msgstr ""
"\"rsync for cloud storage\", CLI that supports Google Drive, S3, Dropbox, "
"Backblaze B2, One Drive, Swift, Hubic, Wasabi, Google Cloud Storage, Azure "
"Blob, Azure Files, Yandex Files."

#: wizestream:1
msgid ".Electron based private streaming client."
msgstr "Client di streaming privato basato su Electron."

#: music-blocks:1
msgid ".Exploring Math, Music, and Programming."
msgstr "Esplorando la matematica, la musica e la programmazione."

#: rainbow-board:1
msgid "22nd Century Whiteboard App."
msgstr "App lavagna interattiva del XXII secolo."

#: steamcad:1
