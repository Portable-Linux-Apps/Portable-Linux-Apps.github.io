[1.926, "o", "----------------------------------------------------------------------------------------------------------------------------------------------------------\r\n\r\n"]
[0.004, "o", " Making aisap sandbox script for \"fluxer\"...\r\n"]
[0.004, "o", "\u001b[33m\r\n Do you want configure access to directories? (Y/n): "]
[3.060, "o", "\r\n"]
[0.004, "o", "\u001b[36m"]
[0.000, "o", " Allow fluxer access to \"~/Desktop\"? (y/N) "]
[2.348, "o", "\r\n"]
[0.003, "o", " Allow fluxer access to \"~/Documents\"? (y/N) "]
[0.973, "o", "\r\n"]
[0.003, "o", " Allow fluxer access to \"~/Downloads\"? (y/N) "]
[0.917, "o", "y"]
[0.320, "o", "\r\n"]
[0.008, "o", " Allow fluxer access to \"~/Games\"? (y/N) "]
[0.863, "o", "\r\n"]
[0.004, "o", " Allow fluxer access to \"~/Music\"? (y/N) "]
[0.702, "o", "\r\n"]
[0.003, "o", " Allow fluxer access to \"~/Pictures\"? (y/N) "]
[0.597, "o", "\r\n"]
[0.003, "o", " Allow fluxer access to \"~/Videos\"? (y/N) "]
[0.804, "o", "\r\n"]
[0.523, "o", "\u001b[31m Allow fluxer access to a specific directory? (y/N) "]
[2.293, "o", "\r\n"]
[0.003, "o", "\r\n\u001b[32m User directories access configured successfully!\r\n"]
