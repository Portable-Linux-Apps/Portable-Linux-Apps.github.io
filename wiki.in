  <h2>_("Related projects")</h2>

  <h3>_("Side Projects")</h3>
  <ul>
    <li><a href="https://github.com/ivan-hc/amcheck" target="_blank" rel="noopener noreferrer">amcheck</a> &mdash; _("checks the validity of scripts in this database and monitors the availability of AppImages")</li>
    <li><a href="https://github.com/ivan-hc/am-extras" target="_blank" rel="noopener noreferrer">am-extras</a> &mdash; _("lists applications from third-party databases")</li>
