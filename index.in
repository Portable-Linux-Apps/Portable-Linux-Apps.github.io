<script>
function handleHomeSearch(event) {
  event.preventDefault();
  var input = document.getElementById('home-search-input');
  var archSelect = document.getElementById('home-arch-select');
  var catSelect = document.getElementById('home-cat-select');

  var searchTerm = input ? input.value.trim() : '';
  var arch = archSelect ? archSelect.value : '';
  var category = catSelect ? catSelect.value : '';

  // If category is selected, go to category page with search and arch params
  if (category) {
    var url = '/' + category + '.html';
    var params = [];
    if (searchTerm) params.push('s=' + encodeURIComponent(searchTerm));
    if (arch) params.push('a=' + encodeURIComponent(arch));
    if (params.length > 0) url += '?' + params.join('&');
    window.location.href = url;
  } else {
    // No category selected, go to apps.html with search and arch params
    var url = '/apps.html';
    var params = [];
    if (searchTerm) params.push('s=' + encodeURIComponent(searchTerm));
    if (arch) params.push('a=' + encodeURIComponent(arch));
    if (params.length > 0) url += '?' + params.join('&');
    window.location.href = url;
  }
}
</script>

</body>
</html>
